况。**", "closed_by": {"login": "citarreikee", "id": 49931345, "node_id": "MDQ6VXNlcjQ5OTMxMzQ1", "avatar_url": "https://avatars.githubusercontent.com/u/49931345?v=4", "gravatar_id": "", "url": "https://api.github.com/users/citarreikee", "html_url": "https://github.com/citarreikee", "followers_url": "https://api.github.com/users/citarreikee/followers", "following_url": "https://api.github.com/users/citarreikee/following{/other_user}", "gists_url": "https://api.github.com/users/citarreikee/gists{/gist_id}", "starred_url": "https://api.github.com/users/citarreikee/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/citarreikee/subscriptions", "organizations_url": "https://api.github.com/users/citarreikee/orgs", "repos_url": "https://api.github.com/users/citarreikee/repos", "events_url": "https://api.github.com/users/citarreikee/events{/privacy}", "received_events_url": "https://api.github.com/users/citarreikee/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "reactions": {"url": "https://api.github.com/repos/citarreikee/AGuild/issues/3/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "timeline_url": "https://api.github.com/repos/citarreikee/AGuild/issues/3/timeline", "performed_via_github_app": null, "state_reason": "completed", "pinned_comment": null}]