server {
    listen 443 ssl;
    server_name entropyfield.com;

    root /home/citarreikee/entroWEB/dist;
    index index.html;

    location = /jojo {
        return 301 /jojo/;
    }

    location /jojo/ {
        alias /home/citarreikee/jojo-site/;
        try_files $uri $uri/ /jojo/index.html;
    }

    location = /jojo-deploy-hook/github {
        limit_except POST { deny all; }
        client_max_body_size 1m;
        proxy_pass http://127.0.0.1:9187/github;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Hub-Signature-256 $http_x_hub_signature_256;
        proxy_set_header X-GitHub-Event $http_x_github_event;
        proxy_set_header X-GitHub-Delivery $http_x_github_delivery;
    }

    location / {
        try_files $uri /index.html;
    }

    ssl_certificate /etc/letsencrypt/live/entropyfield.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/entropyfield.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}
