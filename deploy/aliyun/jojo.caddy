
jojo.entropyfield.com {
    encode zstd gzip
    @private path /.deployed-revision /.git/*
    respond @private 404
    handle /github {
        reverse_proxy 127.0.0.1:9187
    }
    handle {
        root * /opt/jojo/current
        try_files {path} {path}/ /index.html
        file_server
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }
}
