
jojo.entropyfield.com {
    # Targeted crawl diagnostics: exclude application and webhook traffic.
    log {
        output file /var/log/caddy/jojo-crawl.json {
            roll_size 5MiB
            roll_keep 2
        }
        format filter {
            wrap json
            fields {
                request>headers delete
            }
        }
    }
    @notCrawl not path / /robots.txt /sitemap.xml
    log_skip @notCrawl
    encode zstd gzip
    @private path /.deployed-revision /.git/*
    handle @private {
        respond 404
    }
    handle /github {
        reverse_proxy 127.0.0.1:9187
    }
    handle {
        root * /opt/jojo/current
        try_files {path} {path}/ /index.html
        file_server
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }
}
