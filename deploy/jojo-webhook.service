[Unit]
Description=GitHub webhook receiver for Jojo portfolio
After=network.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/jojo-webhook.env
ExecStart=/usr/bin/python3 /usr/local/sbin/jojo-github-webhook
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/systemd

[Install]
WantedBy=multi-user.target
